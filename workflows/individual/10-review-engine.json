          "mode": "name",
          "value": "config"
        },
        "returnAll": true,
        "options": {}
      },
      "id": "36e6e421-6e26-45ac-957e-c2e1ef38161a",
      "name": "Load config",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -260,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Load config').first().json || {};\nconst b = $('Job complete').first().json.body || {};\nconst digits = String(b.phone || '').replace(/[^0-9]/g, '');\nlet phone = '';\nif (digits.length === 10) phone = '+1' + digits;\nelse if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits;\nelse if (digits.length > 11) phone = '+' + digits;\nconst pretty = phone ? phone.replace(/^\\+1(\\d{3})(\\d{3})(\\d{4})$/, '($1) $2-$3') : '';\nconst name = String(b.name || '').trim();\nconst who = name || pretty || 'there';\nconst job = String(b.job || 'the work').trim();\nconst link = String(cfg.review_link || '').trim();\nconst biz = cfg.business_name || 'us';\nconst owner = cfg.owner_name || 'the owner';\n\nconst hrs = Number(cfg.review_delay_hours || 3);\nconst days2 = Number(cfg.review_reminder_days || 3);\nconst tz = cfg.timezone || 'America/New_York';\nconst now = DateTime.now().setZone(tz);\n// Quiet hours in Core 1 will hold anything that lands late, so this only has to get the spacing right.\nconst ask_at = now.plus({ hours: hrs }).toUTC().toISO();\nconst remind_at = now.plus({ hours: hrs }).plus({ days: days2 }).set({ hour: 11, minute: 0, second: 0, millisecond: 0 }).toUTC().toISO();\n\nconst fill = (t, dflt) => String(t || dflt)\n  .replace(/\\{name\\}/g, who).replace(/\\{business\\}/g, biz)\n  .replace(/\\{owner\\}/g, owner).replace(/\\{job\\}/g, job).replace(/\\{link\\}/g, link).trim();\n\n// The gate is deliberate. Any reply stops this cadence through the inbound router and lands\n// with the owner, so an unhappy customer reaches a person instead of a review form.\nreturn [{ json: {\n  ok: !!phone,\n  has_link: !!link,\n  phone, pretty, name, job, link,\n  ask_at, remind_at,\n  ask: fill(cfg.review_ask_text, 'Thanks for having {business} out for {job}, {name}. If anything was not right, reply here and {owner} will sort it out. If we did alright, a quick review helps us more than you would think: {link}'),\n  reminder: fill(cfg.review_reminder_text, 'No pressure {name}, just leaving this here in case you have a minute: {link}. And if something was off instead, reply here and {owner} will take care of it.'),\n  owner_text: 'Review ask queued for ' + who + ' ' + pretty + ' after ' + job + '.',\n  no_link_text: 'A job was marked complete for ' + who + ' but no review_link is set in the config table, so nothing was sent. Add the Google review link and it will work from the next job.'\n} }];\n"
      },
