      "id": "7c480f34-497c-491b-9b77-1ae8e845f001",
      "name": "Job complete",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -460,
        300
      ],
      "webhookId": "f610872a-f986-4a44-a487-aced047e5b8e"
