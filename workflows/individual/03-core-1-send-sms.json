    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Load config').first().json;\nconst q = $('Quiet hours').first().json;\nconst prior = $('Prior outbound').all().filter(i => i.json && i.json.id);\nlet body = String(q.body || '');\nconst footer = String(cfg.stop_footer || '').trim();\n// The registered A2P campaign promises the opt-out line on every message, so it goes on every customer text, not only the first.\nif (footer && !body.toUpperCase().includes('STOP')) body = body + ' ' + footer;\nreturn [{ json: { phone: q.phone, body, kind: q.kind, from: cfg.business_number, deferred: !!q.defer, first_message: prior.length === 0 } }];\n"
      },
