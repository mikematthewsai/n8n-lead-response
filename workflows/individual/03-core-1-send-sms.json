    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Load config').first().json;\nconst input = $('When called').first().json;\nconst tz = cfg.timezone || 'America/New_York';\nconst now = DateTime.now().setZone(tz);\nconst [qsH, qsM] = String(cfg.quiet_start || '20:00').split(':').map(Number);\nconst [qeH, qeM] = String(cfg.quiet_end || '08:00').split(':').map(Number);\nconst mins = now.hour * 60 + now.minute;\nconst qs = qsH * 60 + qsM, qe = qeH * 60 + qeM;\nlet quiet;\nif (qs > qe) quiet = (mins >= qs || mins < qe); else quiet = (mins >= qs && mins < qe);\nconst skip = String(input.skip_quiet_hours) === 'true';\nconst defer = quiet && !skip;\nlet resumeAt = null;\nif (defer) {\n  let r = now.set({ hour: qeH, minute: qeM, second: 0, millisecond: 0 });\n  if (r <= now) r = r.plus({ days: 1 });\n  resumeAt = r.toUTC().toISO();\n}\nreturn [{ json: { phone: input.phone, body: input.body, kind: input.kind, quiet, defer, resume_at: resumeAt, local_time: now.toFormat('HH:mm') } }];\n"
      },
