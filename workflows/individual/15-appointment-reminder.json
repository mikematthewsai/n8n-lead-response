      "id": "5f846333-e05a-4aed-bc55-de1b1bee67a9",
      "name": "Load config",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -260,
        300
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Load config').first().json || {};\nconst b = $('Appointment booked').first().json.body || {};\n\nconst digits = String(b.phone || '').replace(/[^0-9]/g, '');\nlet phone = '';\nif (digits.length === 10) phone = '+1' + digits;\nelse if (digits.length === 11 && digits.startsWith('1')) phone = '+' + digits;\nelse if (digits.length > 11) phone = '+' + digits;\nconst pretty = phone ? phone.replace(/^\\+1(\\d{3})(\\d{3})(\\d{4})$/, '($1) $2-$3') : '';\n\nconst name = String(b.name || '').trim();\nconst who = name || pretty || 'there';\nconst job = String(b.job || 'your appointment').trim();\nconst address = String(b.address || '').trim();\nconst biz = cfg.business_name || 'us';\nconst owner = cfg.owner_name || 'the owner';\nconst tz = cfg.timezone || 'America/New_York';\nconst now = DateTime.now().setZone(tz);\n\n// Hours before the appointment, config driven. Read explicitly so a configured 0 survives.\nconst num = (v, dflt) => {\n  if (v === null || v === undefined || String(v).trim() === '') return dflt;\n  const n = Number(v);\n  return Number.isFinite(n) && n >= 0 ? n : dflt;\n};\nconst h1 = num(cfg.appt_reminder_1_hours, 24);\nconst h2 = num(cfg.appt_reminder_2_hours, 2);\n\n// The time arrives as ISO or 'YYYY-MM-DD HH:mm'. Anything else is rejected rather than\n// guessed at, because a reminder sent at the wrong hour is worse than no reminder.\nconst raw = String(b.when || b.appointment_at || '').trim();\nlet appt = raw ? DateTime.fromISO(raw, { zone: tz }) : null;\nif (appt && !appt.isValid) appt = DateTime.fromFormat(raw, 'yyyy-MM-dd HH:mm', { zone: tz });\nif (appt && !appt.isValid) appt = DateTime.fromFormat(raw, 'yyyy-MM-dd h:mm a', { zone: tz });\nconst hasWhen = !!(appt && appt.isValid);\nconst inFuture = hasWhen && appt > now;\n\nconst whenWords = hasWhen ? appt.toFormat(\"cccc d LLLL 'at' h:mm a\") : 'your appointment';\nconst dayWords = hasWhen ? appt.toFormat('cccc') : 'that day';\nconst timeWords = hasWhen ? appt.toFormat('h:mm a') : '';\n\n// Quiet hours are resolved here rather than left to the send path. The send path defers a\n// quiet hours message to the morning, and a reminder deferred to the morning can land after\n// the appointment it was reminding about. So a reminder inside quiet hours is moved to the\n// moment quiet hours end, and dropped if that is not before the appointment.\nconst hhmm = (s, dflt) => {\n  const m = String(s || dflt).match(/^(\\d{1,2}):(\\d{2})$/);\n  return m ? { h: Number(m[1]), m: Number(m[2]) } : { h: Number(dflt.split(':')[0]), m: 0 };\n};\nconst qs = hhmm(cfg.quiet_start, '20:00');\nconst qe = hhmm(cfg.quiet_end, '08:00');\nconst qsM = qs.h * 60 + qs.m, qeM = qe.h * 60 + qe.m;\nconst minutesOf = (d) => d.hour * 60 + d.minute;\nconst inQuiet = (d) => {\n  const t = minutesOf(d);\n  return qsM <= qeM ? (t >= qsM && t < qeM) : (t >= qsM || t < qeM);\n};\nconst nextQuietEnd = (d) => {\n  let e = d.set({ hour: qe.h, minute: qe.m, second: 0, millisecond: 0 });\n  if (e <= d) e = e.plus({ days: 1 });\n  return e;\n};\nconst usable = (t) => {\n  if (!t) return null;\n  let when = t < now ? now : t;\n  if (inQuiet(when)) when = nextQuietEnd(when);\n  if (!appt || when >= appt) return null;\n  if (when <= now.plus({ minutes: 1 })) return null;\n  return when;\n};\n\nconst t1 = usable(hasWhen ? appt.minus({ hours: h1 }) : null);\nconst t2 = usable(hasWhen ? appt.minus({ hours: h2 }) : null);\n// Two reminders that would land within five minutes of each other are one reminder.\nconst same = !!(t1 && t2 && Math.abs(t1.diff(t2, 'minutes').minutes) < 5);\nconst send1 = !!(inFuture && t1);\nconst send2 = !!(inFuture && t2 && !same);\n\nconst fill = (t, dflt) => String(t || dflt)\n  .replace(/\\{name\\}/g, who).replace(/\\{business\\}/g, biz).replace(/\\{owner\\}/g, owner)\n  .replace(/\\{when\\}/g, whenWords).replace(/\\{day\\}/g, dayWords).replace(/\\{time\\}/g, timeWords)\n  .replace(/\\{job\\}/g, job).replace(/\\{address\\}/g, address).trim();\n\nreturn [{ json: {\n  ok: !!phone && inFuture,\n  phone, pretty, name, job, address,\n  source: 'appointment',\n  when_iso: hasWhen ? appt.toUTC().toISO() : '',\n  when_words: whenWords,\n  send_1: send1,\n  send_2: send2,\n  reminder_1_at: send1 ? t1.toUTC().toISO() : now.plus({ seconds: 5 }).toUTC().toISO(),\n  reminder_2_at: send2 ? t2.toUTC().toISO() : now.plus({ seconds: 10 }).toUTC().toISO(),\n  reminder_1: fill(cfg.appt_reminder_1_text, 'Hi {name}, reminder from {business}: we have you down for {when}. Reply here if that no longer works and we will move it.'),\n  reminder_2: fill(cfg.appt_reminder_2_text, 'Hi {name}, {business} here, we are on for {time} today. Reply here if anything changed.'),\n  owner_text: 'Appointment booked: ' + who + ' ' + pretty + ', ' + whenWords + (address ? ', ' + address : '') + '. Reminders set.'\n} }];\n"
      },
