    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Load config (help)').first().json;\nconst n = String(cfg.business_number || '').replace(/\\D/g, '');\nconst pretty = n.length === 11 ? '(' + n.slice(1, 4) + ') ' + n.slice(4, 7) + '-' + n.slice(7) : cfg.business_number;\nconst text = String(cfg.help_text || '{business_name}. Reply STOP to opt out.')\n  .replace(/\\{business_name\\}/g, cfg.business_name || '')\n  .replace(/\\{business_number_pretty\\}/g, pretty || '');\nreturn [{ json: { phone: $('Normalize').first().json.phone, body: text } }];\n"
      },
