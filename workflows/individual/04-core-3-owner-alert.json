    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Load config').first().json;\nconst input = $('When called').first().json;\nconst ch = String(cfg.alert_channel || 'sms').toLowerCase();\nconst high = String(input.urgency || '').toLowerCase() === 'high';\nconst words = { new_lead: 'New lead', missed_call: 'Missed call', reply: 'Customer reply', cadence_done: 'Follow-up finished', error: 'Error', duplicate: 'Same lead again' };\nreturn [{ json: {\n  send_sms: ch === 'sms' || ch === 'both',\n  send_email: ch === 'email' || ch === 'both',\n  sms_text: (high ? 'NEW LEAD: ' : '') + String(input.text || ''),\n  subject: (words[input.event] || input.event || 'Alert') + ' - ' + (cfg.business_name || ''),\n  email_text: String(input.text || '') + (input.phone ? '\\n\\nContact: ' + input.phone : ''),\n  from: cfg.business_number, owner_cell: cfg.owner_cell, owner_email: cfg.owner_email,\n  event: input.event, phone: input.phone\n} }];\n"
      },
      "id": "24bb57d6-3002-46e4-ab94-0ed0ac1d5b7e",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "75ab3880-8826-4d6e-9676-bbe477c318ba",
              "leftValue": "={{ $json.send_sms === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
