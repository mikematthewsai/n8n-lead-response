    {
      "parameters": {
        "jsCode": "\nconst b = $json.body || {};\nconst raw = String(b.phone || b.Phone || b.mobile || '');\nconst d = raw.replace(/\\D/g, '');\nlet phone = '';\nif (d.length === 10) phone = '+1' + d;\nelse if (d.length === 11 && d.startsWith('1')) phone = '+' + d;\nelse if (d.length > 11) phone = '+' + d;\nif (!phone) throw new Error('Lead has no usable phone number: ' + JSON.stringify(b));\nreturn [{ json: {\n  phone,\n  name: String(b.name || b.Name || ((b.first_name || '') + ' ' + (b.last_name || '')).trim() || ''),\n  source: String(b.source || 'website_form'),\n  message: String(b.message || b.Message || b.notes || '') + (b.address ? ' Address: ' + b.address : '')\n} }];\n"
      },
      "id": "e8783438-44ed-4bcb-93b2-3fbfd93e62f0",
